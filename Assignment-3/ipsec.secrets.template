# IPsec PSK - construct with: RollNo1RollNo2CS6530-IPsec-Assignment-2026
# Example (replace with actual roll numbers in UPPER CASE):
# CS24B001CS24B002CS6530-IPsec-Assignment-2026
#
# This is the Site A format. Site B uses the same PSK.
# Place this in /etc/ipsec.secrets on both gateways

<GW-A-WAN-IP> <GW-B-WAN-IP> : PSK "ROLLNO1ROLLNO2CS6530-IPsec-Assignment-2026"

# After creating the file with actual values:
# sudo chmod 600 /etc/ipsec.secrets
